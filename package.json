{
  "name": "lune-de-beaute",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npx next dev apps/web",
    "dev:web": "npx next dev apps/web",
    "dev:api": "npm --workspace=api run dev",
    "dev:all": "concurrently \"npm:dev:web\" \"npm:dev:api\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}